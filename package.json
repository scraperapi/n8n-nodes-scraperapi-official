{
	"name": "n8n-nodes-scraperapi-official",
	"version": "1.2.1",
	"description": "Official ScraperAPI nodes for n8n",
	"license": "MIT",
	"homepage": "https://www.scraperapi.com",
	"keywords": [
		"n8n-community-node-package",
		"scraperapi",
		"n8n"
	],
	"author": {
		"name": "ScraperAPI",
		"email": "support@scraperapi.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/scraperapi/n8n-nodes-scraperapi-official.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ScraperApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ScraperApi/ScraperApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.29.1",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.0.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
